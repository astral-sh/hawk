{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>astral-sh/renovate-config"],
  enabledManagers: ["npm"],
  packageRules: [
    {
      matchManagers: ["npm"],
      enabled: false,
    },
    {
      matchManagers: ["npm"],
      matchFileNames: ["package.json"],
      enabled: true,
    },
  ],
}
